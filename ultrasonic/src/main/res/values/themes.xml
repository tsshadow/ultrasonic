<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CleanSearchStyle" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@drawable/pill_background</item>
        <item name="submitBackground">@null</item>
        <item name="android:paddingHorizontal">4dp</item>
    </style>

    <!-- Here we define some basic attributes that are the same for each theme -->
    <style name="UltrasonicTheme.Base" parent="">
        <item name="searchViewStyle">@style/CleanSearchStyle</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/spotify_black</item>
        <item name="android:navigationBarColor">@color/spotify_black</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- The day & night theme. There is a night specific override in the values-night folder -->
    <style name="UltrasonicTheme.DayNight" parent="UltrasonicTheme.Black">
    </style>

    <style name="UltrasonicTheme.Black" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorPrimaryDark">@color/spotify_black</item>
        <item name="colorAccent">@color/spotify_green</item>
        <item name="android:colorBackground">@color/spotify_black</item>
        <item name="colorSurface">@color/spotify_black</item>
        <item name="colorSurfaceVariant">@color/spotify_card</item>
        <item name="colorControlNormal">@color/spotify_text_secondary</item>
        <item name="android:textColorPrimary">@color/spotify_text_primary</item>
        <item name="android:textColorSecondary">@color/spotify_text_secondary</item>
    </style>

    <style name="UltrasonicTheme.Dark" parent="UltrasonicTheme.Black">
    </style>

    <style name="UltrasonicTheme.Light" parent="UltrasonicTheme.Black">
    </style>

</resources>