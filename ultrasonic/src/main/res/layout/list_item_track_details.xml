<?xml version="1.0" encoding="utf-8"?><!-- DON'T CONVERT TO ConstraintLayout! We have been there and it was slower than LinearLayout :) -->
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="0dp"
    a:layout_height="wrap_content"
    a:layout_gravity="center_vertical"
    a:layout_marginStart="4dp"
    a:layout_weight="1"
    a:orientation="vertical"
    a:layout_marginRight="2dp"
    tools:layout_height="?android:attr/listPreferredItemHeight"
    tools:layout_width="match_parent">
    <!-- Titel + status -->
    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:gravity="center_vertical"
        a:orientation="horizontal">

        <!-- Tracknummer optioneel -->
        <TextView
            a:id="@+id/song_track_number"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_marginEnd="6dp"
            a:text="1."
            a:textAppearance="?android:attr/textAppearanceMedium"
            a:textColor="?android:textColorSecondary"
            a:visibility="gone"
            tools:ignore="HardcodedText" />

        <!-- Titel -->
        <TextView
            a:id="@+id/song_title"
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_weight="1"
            a:ellipsize="end"
            a:maxLines="1"
            a:text="Song Title"
            a:textSize="15sp"
            a:textStyle="bold"
            a:textColor="@color/spotify_text_primary"
            tools:ignore="HardcodedText" />

        <!-- Status icons -->
        <ImageView
            a:id="@+id/song_status_image"
            a:layout_width="20dp"
            a:layout_height="20dp"
            a:layout_marginStart="8dp"
            a:layout_marginEnd="4dp"
            a:contentDescription="@null"
            a:visibility="gone"
            app:tint="?android:textColorSecondary" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            a:id="@+id/song_status_progress"
            a:layout_width="20dp"
            a:layout_height="20dp"
            a:layout_marginEnd="4dp"
            a:indeterminate="true"
            a:visibility="gone"
            app:indicatorColor="@color/spotify_green"
            app:indicatorSize="20dp"
            app:trackColor="@color/spotify_card" />
    </LinearLayout>

    <!-- Artiest + Album + Duur -->
    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="2dp"
        a:orientation="horizontal">

        <TextView
            a:id="@+id/song_artist"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:ellipsize="end"
            a:maxLines="1"
            a:text="Artist name"
            a:textSize="13sp"
            a:textColor="@color/spotify_text_secondary"
            tools:ignore="HardcodedText" />

        <TextView
            a:id="@+id/song_album_separator"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:text=" • "
            a:textSize="13sp"
            a:textColor="@color/spotify_text_secondary"
            tools:ignore="HardcodedText" />

        <TextView
            a:id="@+id/song_album"
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_weight="1"
            a:ellipsize="end"
            a:maxLines="1"
            a:text="Album name"
            a:textSize="13sp"
            a:textColor="@color/spotify_text_secondary"
            tools:ignore="HardcodedText" />

        <TextView
            a:id="@+id/song_year"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_marginEnd="6dp"
            a:textSize="13sp"
            a:textColor="@color/spotify_text_secondary"
            a:visibility="gone"
            tools:text="2023" />

        <TextView
            a:id="@+id/song_duration"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:text="2:42"
            a:textSize="13sp"
            a:textColor="@color/spotify_text_secondary"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</LinearLayout>