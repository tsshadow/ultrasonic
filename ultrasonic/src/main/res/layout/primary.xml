<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:background="@color/spotify_black"
    a:fillViewport="true">

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="vertical"
        a:paddingBottom="80dp">

        <TextView
            a:id="@+id/welcome_message"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:paddingStart="16dp"
            a:paddingTop="32dp"
            a:paddingEnd="16dp"
            a:paddingBottom="16dp"
            a:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            a:textStyle="bold"
            a:textColor="@color/spotify_text_primary"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            a:id="@+id/section_playlists_title"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:paddingStart="16dp"
            a:paddingTop="16dp"
            a:paddingEnd="16dp"
            a:paddingBottom="8dp"
            a:text="@string/playlist.label"
            a:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            a:textStyle="bold"
            a:textColor="@color/spotify_text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            a:id="@+id/recent_playlists_recycler"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:nestedScrollingEnabled="false"
            a:paddingStart="8dp"
            a:paddingEnd="8dp" />

        <TextView
            a:id="@+id/section_albums_title"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:paddingStart="16dp"
            a:paddingTop="24dp"
            a:paddingEnd="16dp"
            a:paddingBottom="8dp"
            a:text="@string/main.albums_newest"
            a:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            a:textStyle="bold"
            a:textColor="@color/spotify_text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            a:id="@+id/recent_albums_recycler"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:nestedScrollingEnabled="false"
            a:paddingStart="8dp"
            a:paddingEnd="8dp" />

        <TextView
            a:id="@+id/section_artists_title"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:paddingStart="16dp"
            a:paddingTop="24dp"
            a:paddingEnd="16dp"
            a:paddingBottom="8dp"
            a:text="@string/main.artists_title"
            a:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            a:textStyle="bold"
            a:textColor="@color/spotify_text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            a:id="@+id/recent_artists_recycler"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:nestedScrollingEnabled="false"
            a:paddingStart="8dp"
            a:paddingEnd="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>