<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:background="@color/spotify_black"
    a:fillViewport="true">

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="vertical"
        a:paddingBottom="80dp">

        <LinearLayout
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical"
            a:paddingStart="16dp"
            a:paddingTop="16dp"
            a:paddingEnd="16dp"
            a:paddingBottom="8dp">

            <HorizontalScrollView
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    a:id="@+id/filter_chip_group"
                    a:layout_width="wrap_content"
                    a:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        a:id="@+id/chip_recent"
                        style="@style/Widget.Material3.Chip.Filter"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:text="@string/filter.recent"
                        a:textColor="@color/spotify_text_primary"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        a:id="@+id/chip_favorites"
                        style="@style/Widget.Material3.Chip.Filter"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:text="@string/filter.favorites"
                        a:textColor="@color/spotify_text_primary"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        a:id="@+id/chip_new"
                        style="@style/Widget.Material3.Chip.Filter"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:text="@string/filter.new"
                        a:textColor="@color/spotify_text_primary"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        a:id="@+id/chip_genres"
                        style="@style/Widget.Material3.Chip.Filter"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:text="@string/filter.genres"
                        a:textColor="@color/spotify_text_primary"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        a:id="@+id/chip_playlists"
                        style="@style/Widget.Material3.Chip.Filter"
                        a:layout_width="wrap_content"
                        a:layout_height="wrap_content"
                        a:text="@string/filter.playlists"
                        a:textColor="@color/spotify_text_primary"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="0dp" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            a:id="@+id/section_recently_played"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical"
            a:visibility="gone">
            <TextView
                a:id="@+id/section_recently_played_title"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:paddingStart="16dp"
                a:paddingTop="20dp"
                a:paddingEnd="16dp"
                a:paddingBottom="4dp"
                a:text="@string/main_recently_played"
                a:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                a:textStyle="bold"
                a:textColor="@color/spotify_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                a:id="@+id/recently_played_recycler"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:nestedScrollingEnabled="false"
                a:paddingStart="12dp"
                a:paddingEnd="12dp" />
        </LinearLayout>

        <LinearLayout
            a:id="@+id/section_playlists"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical">
            <LinearLayout
                a:id="@+id/section_playlists_header"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="horizontal"
                a:paddingStart="16dp"
                a:paddingTop="20dp"
                a:paddingEnd="16dp"
                a:paddingBottom="4dp"
                a:background="?attr/selectableItemBackground"
                a:clickable="true"
                a:focusable="true">

                <TextView
                    a:id="@+id/section_playlists_title"
                    a:layout_width="0dp"
                    a:layout_height="wrap_content"
                    a:layout_weight="1"
                    a:text="@string/playlist.label"
                    a:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    a:textStyle="bold"
                    a:textColor="@color/spotify_text_primary" />

                <ImageView
                    a:layout_width="20dp"
                    a:layout_height="20dp"
                    a:layout_gravity="center_vertical"
                    a:src="@drawable/ic_chevron_right"
                    app:tint="@color/spotify_text_secondary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                a:id="@+id/recent_playlists_recycler"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:nestedScrollingEnabled="false"
                a:paddingStart="12dp"
                a:paddingEnd="12dp" />
        </LinearLayout>

        <LinearLayout
            a:id="@+id/section_recent_songs"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical">
            <LinearLayout
                a:id="@+id/section_recent_songs_header"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="horizontal"
                a:paddingStart="16dp"
                a:paddingTop="16dp"
                a:paddingEnd="16dp"
                a:paddingBottom="4dp"
                a:background="?attr/selectableItemBackground"
                a:clickable="true"
                a:focusable="true">

                <TextView
                    a:id="@+id/section_recent_songs_title"
                    a:layout_width="0dp"
                    a:layout_height="wrap_content"
                    a:layout_weight="1"
                    a:text="@string/main.songs"
                    a:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    a:textStyle="bold"
                    a:textColor="@color/spotify_text_primary" />

                <ImageView
                    a:layout_width="20dp"
                    a:layout_height="20dp"
                    a:layout_gravity="center_vertical"
                    a:src="@drawable/ic_chevron_right"
                    app:tint="@color/spotify_text_secondary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                a:id="@+id/recent_songs_recycler"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:nestedScrollingEnabled="false"
                a:paddingStart="12dp"
                a:paddingEnd="12dp" />
        </LinearLayout>

        <LinearLayout
            a:id="@+id/section_albums"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical">
            <LinearLayout
                a:id="@+id/section_albums_header"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:orientation="horizontal"
                a:paddingStart="16dp"
                a:paddingTop="20dp"
                a:paddingEnd="16dp"
                a:paddingBottom="4dp"
                a:background="?attr/selectableItemBackground"
                a:clickable="true"
                a:focusable="true">

                <TextView
                    a:id="@+id/section_albums_title"
                    a:layout_width="0dp"
                    a:layout_height="wrap_content"
                    a:layout_weight="1"
                    a:text="@string/main.albums_newest"
                    a:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    a:textStyle="bold"
                    a:textColor="@color/spotify_text_primary" />

                <ImageView
                    a:layout_width="20dp"
                    a:layout_height="20dp"
                    a:layout_gravity="center_vertical"
                    a:src="@drawable/ic_chevron_right"
                    app:tint="@color/spotify_text_secondary" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                a:id="@+id/recent_albums_recycler"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:nestedScrollingEnabled="false"
                a:paddingStart="12dp"
                a:paddingEnd="12dp" />
        </LinearLayout>


        <LinearLayout
            a:id="@+id/section_artists"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical">
            <TextView
                a:id="@+id/section_artists_title"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:paddingStart="16dp"
                a:paddingTop="20dp"
                a:paddingEnd="16dp"
                a:paddingBottom="4dp"
                a:text="@string/main.artists_title"
                a:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                a:textStyle="bold"
                a:textColor="@color/spotify_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                a:id="@+id/recent_artists_recycler"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:nestedScrollingEnabled="false"
                a:paddingStart="12dp"
                a:paddingEnd="12dp" />
        </LinearLayout>

        <LinearLayout
            a:id="@+id/section_genres"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:orientation="vertical"
            a:visibility="gone">
            <TextView
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:paddingStart="16dp"
                a:paddingTop="20dp"
                a:paddingEnd="16dp"
                a:paddingBottom="4dp"
                a:text="@string/filter.genres"
                a:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                a:textStyle="bold"
                a:textColor="@color/spotify_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                a:id="@+id/recent_genres_recycler"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:nestedScrollingEnabled="false"
                a:paddingStart="12dp"
                a:paddingEnd="12dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>